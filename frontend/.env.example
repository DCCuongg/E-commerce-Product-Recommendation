# Start local UI demo with VITE_DEMO_MODE=true in .env.local.
# Demo mode is intentionally disabled in production builds.
VITE_DEMO_MODE=false

# Empty base URL means same-origin /api/v1/* routes (AKS ingress).
VITE_API_BASE_URL=

# Optional separate backend hosts for development.
# VITE_AUTH_API_URL=http://localhost:8001
# VITE_ORDER_API_URL=http://localhost:8002
# VITE_RECOMMENDER_API_URL=http://localhost:8003
# VITE_FAAS_URL=

# Optional development-only rollback testing control (do not enable for customers).
# VITE_ENABLE_FAILURE_TEST=true
