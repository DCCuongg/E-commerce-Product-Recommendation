# ==========================================
# 1. Môi trường & Bí mật (Secrets / Credentials)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
azure_functions/local.settings.json

# ==========================================
# 2. Python & Môi trường ảo (Virtual Environments)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 3. Jupyter Notebooks & Colab Checkpoints
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# 4. Dữ liệu huấn luyện & Artifacts (Data & Models)
# ==========================================
# Loại trừ dữ liệu lớn và dữ liệu đã xử lý
data/raw/*
!data/raw/meta_sample.jsonl
!data/raw/review_sample.jsonl
data/processed/*
!data/processed/.gitkeep

# Model weights, embeddings, vector cache
*.pkl
*.joblib
*.model
*.h5
*.pt
*.onnx
*.parquet

# ==========================================
# 5. Frontend (Node.js / React / Vite)
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 6. Kubernetes, Docker & Local Dev Run
# ==========================================
# Tránh commit secrets k8s nếu có tạo riêng cục bộ
k8s/secrets.yaml
k8s/*-secret.yaml

# Docker runtime & volumes mount
.docker/

# ==========================================
# 7. IDE, OS & System Files
# ==========================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
